# Canonical public origin. Use HTTPS and omit paths, query strings, or credentials.
NEXT_PUBLIC_SITE_URL=https://lifemap.fyi

# Verified public contact shown on support and policy pages. Leave empty until operational.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Paid reports default closed. Set true only after every readiness flag below is verified.
PAID_REPORTS_ENABLED=false
REPORT_PUBLIC_ACCESS_CONFIRMED=false
REPORT_WEBHOOKS_CONFIGURED=false
REPORT_CLEANUP_CONFIGURED=false
REPORT_POLICIES_CONFIRMED=false
REPORT_TEST_ORDERS_ONLY=true

# Server-only Shopify and delivery configuration. Never prefix these keys with NEXT_PUBLIC_.
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
RESEND_API_KEY=
REPORT_DELIVERY_FROM=Life Map <reports@lifemap.fyi>

# Generate independent random secrets. REPORT_PII_KEY must be base64 for exactly 32 bytes.
REPORT_TOKEN_SECRET=
REPORT_EMAIL_HASH_SECRET=
REPORT_RATE_LIMIT_SECRET=
REPORT_PII_KEY=
